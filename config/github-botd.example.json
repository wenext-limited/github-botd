{
  "version": 1,
  "state_dir": "../state",
  "dry_run": true,
  "ipc": {"socket": "../run/github-botd.sock"},
  "webhook": {
    "bind": "127.0.0.1:8787",
    "allow_non_loopback": false,
    "sources": {"main": {"secret_env": "GITHUB_BOTD_WEBHOOK_SECRET"}}
  },
  "github": {
    "token_env": "GITHUB_BOTD_GITHUB_TOKEN",
    "username": "your-machine-user"
  },
  "repositories": {"project": {"full_name": "your-org/your-repo"}},
  "clients": {
    "reviewer": {
      "token_env": "GITHUB_BOTD_REVIEWER_TOKEN",
      "repositories": ["project"],
      "capabilities": ["events.read", "events.replay", "context.read", "issue.comment.create", "review.reply", "review.comment", "review.submit"]
    },
    "ci": {
      "token_env": "GITHUB_BOTD_CI_TOKEN",
      "repositories": ["project"],
      "capabilities": ["events.read", "events.replay", "context.read"]
    }
  },
  "routes": [
    {"id": "mentions", "repositories": ["project"], "events": ["issue_comment", "pull_request_review_comment"], "actions": ["created"], "trigger": "mention", "names": ["your-machine-user"], "actors": ["your-trusted-user"], "clients": ["reviewer"]},
    {"id": "review-requests", "repositories": ["project"], "events": ["pull_request"], "actions": ["review_requested"], "trigger": "review_requested", "names": ["your-machine-user"], "actors": ["your-trusted-user"], "clients": ["reviewer"]},
    {"id": "ci-events", "repositories": ["project"], "events": ["workflow_run", "check_run", "check_suite"], "trigger": "any", "actors": ["your-trusted-user", "github-actions[bot]"], "include_bots": true, "clients": ["ci"]}
  ],
  "poll": {"enabled": false, "interval_seconds": 60, "repositories": ["project"]},
  "limits": {"max_body_bytes": 2097152, "lease_seconds": 120, "max_attempts": 8, "max_pending": 100000}
}
